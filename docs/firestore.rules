rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['creatorName','questions','game','createdAt']) && request.resource.data.creatorName is string && request.resource.data.creatorName.size() <= 30 && request.resource.data.questions is list && request.resource.data.questions.size() <= 20;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCount']) && request.resource.data.acceptedCount is number && request.resource.data.acceptedCount == resource.data.acceptedCount + 1;
      allow delete: if false;
      match /players/{playerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name','score','total','submittedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 30 && request.resource.data.score is number && request.resource.data.total is number && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total;
        allow update, delete: if false;
      }
      match /accepts/{acceptId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name','acceptedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 30;
        allow update, delete: if false;
      }
      match /starts/{startId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 6;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function validAd(d) {
      return d.title is string && d.title.size() >= 2 && d.title.size() <= 80
        && d.category in ['shop','project','service','page','other']
        && d.city is string && d.city.size() <= 30
        && d.description is string && d.description.size() >= 20 && d.description.size() <= 800
        && d.links is list && d.links.size() >= 1 && d.links.size() <= 4
        && d.shareProof is string && d.shareProof.size() <= 300 && d.shareProof.matches('https?://.+')
        && d.ownerName is string && d.ownerName.size() <= 40;
    }

    match /ads/{adId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin()));

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title','category','city','description','links','shareProof','ownerName','ownerUid','status','adminNote','likeCount','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.likeCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validAd(request.resource.data);

      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && resource.data.status in ['pending','changes']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','category','city','description','links','shareProof','ownerName','status','updatedAt'])
            && request.resource.data.status == 'pending'
            && request.resource.data.updatedAt == request.time
            && validAd(request.resource.data))
        || (request.auth != null
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && ((request.resource.data.likeCount == resource.data.likeCount + 1
                 && !exists(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid))
                 && existsAfter(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid)))
             || (request.resource.data.likeCount == resource.data.likeCount - 1
                 && exists(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid))
                 && !existsAfter(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid)))));

      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid && resource.data.status != 'approved');

      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && getAfter(/databases/$(database)/documents/ads/$(adId)).data.likeCount == get(/databases/$(database)/documents/ads/$(adId)).data.likeCount + 1;
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/ads/$(adId)).data.likeCount == get(/databases/$(database)/documents/ads/$(adId)).data.likeCount - 1;
        allow update: if false;
      }
    }
  }
}
