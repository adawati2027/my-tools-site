rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['creatorName','questions','game','acceptedCount','createdAt']) && request.resource.data.keys().hasAll(['creatorName','questions','game','createdAt']) && request.resource.data.game is string && request.resource.data.game.size() <= 60 && request.resource.data.get('acceptedCount', 0) == 0 && request.resource.data.createdAt == request.time && request.resource.data.creatorName is string && request.resource.data.creatorName.size() <= 30 && request.resource.data.questions is list && request.resource.data.questions.size() <= 20;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCount']) && request.resource.data.acceptedCount is number && request.resource.data.acceptedCount == resource.data.acceptedCount + 1;
      allow delete: if false;
      match /players/{playerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name','score','total','timeMs','submittedAt']) && request.resource.data.keys().hasAll(['name','score','total','submittedAt']) && request.resource.data.submittedAt == request.time && request.resource.data.get('timeMs', 0) is number && request.resource.data.name is string && request.resource.data.name.size() <= 30 && request.resource.data.score is number && request.resource.data.total is number && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total;
        allow update, delete: if false;
      }
      match /accepts/{acceptId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name','acceptedAt']) && request.resource.data.keys().hasAll(['name','acceptedAt']) && request.resource.data.acceptedAt == request.time && request.resource.data.name is string && request.resource.data.name.size() <= 30;
        allow update, delete: if false;
      }
      match /starts/{startId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['startedAt']) && request.resource.data.startedAt == request.time
          && exists(/databases/$(database)/documents/challenges/$(challengeId));
        allow update, delete: if false;
      }
      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && !chatBlocked()
          && request.resource.data.keys().hasOnly(['uid','name','text','voice','dur','createdAt'])
          && (!('voice' in request.resource.data) || (request.resource.data.voice == true && request.resource.data.dur is number && request.resource.data.dur <= 21))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chatMeta/$(request.auth.uid)).data.lastAt == request.time
          && (!exists(/databases/$(database)/documents/chatMeta/$(request.auth.uid))
              || get(/databases/$(database)/documents/chatMeta/$(request.auth.uid)).data.lastAt < request.time - duration.value(3, 's'));
        allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
      match /voices/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid','audio','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.audio is string && request.resource.data.audio.size() < 600000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/challenges/$(challengeId)/messages/$(msgId)).data.uid == request.auth.uid;
        allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 6;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /chatMeta/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time;
    }

    function banLive(p) {
      return exists(p) && (!('until' in get(p).data) || get(p).data.until == 0 || get(p).data.until > request.time.toMillis());
    }

    function chatBlocked() {
      return banLive(/databases/$(database)/documents/chatBans/$(request.auth.uid))
        || ('email' in request.auth.token && banLive(/databases/$(database)/documents/emailBans/$(request.auth.token.email.lower())));
    }

    match /chatBans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /emailBans/{emailKey} {
      allow read: if request.auth != null && (isAdmin() || ('email' in request.auth.token && request.auth.token.email.lower() == emailKey));
      allow write: if isAdmin();
    }

    match /chatReports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['challengeId','msgId','text','offenderUid','offenderName','reason','reporterUid','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function validAd(d) {
      return d.title is string && d.title.size() >= 2 && d.title.size() <= 80
        && d.category in ['shop','project','service','page','other']
        && d.city is string && d.city.size() <= 30
        && d.description is string && d.description.size() >= 20 && d.description.size() <= 800
        && d.links is list && d.links.size() >= 1 && d.links.size() <= 4
        && d.shareProof is string && d.shareProof.size() <= 300 && (d.shareProof.size() == 0 || d.shareProof.matches('https?://.+'))
        && d.hasProofImage is bool && (d.shareProof.size() > 0 || d.hasProofImage)
        && d.igHandle is string && d.igHandle.size() >= 2 && d.igHandle.size() <= 40
        && d.phone is string && d.phone.size() <= 20
        && d.ownerName is string && d.ownerName.size() <= 40;
    }

    function ratingDeltaOk(adId) {
      let adPath = /databases/$(database)/documents/ads/$(adId);
      let revPath = /databases/$(database)/documents/ads/$(adId)/reviews/$(request.auth.uid);
      let before = get(adPath).data;
      let after = getAfter(adPath).data;
      let had = exists(revPath);
      let has = existsAfter(revPath);
      let oldR = had ? get(revPath).data.rating : 0;
      let newR = has ? getAfter(revPath).data.rating : 0;
      return after.get('ratingCount', 0) == before.get('ratingCount', 0) + (has ? 1 : 0) - (had ? 1 : 0)
        && after.get('ratingSum', 0) == before.get('ratingSum', 0) + newR - oldR;
    }

    match /adReports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['adId','reviewUid','reason','reporterUid','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.adId is string && request.resource.data.adId.size() <= 40
        && request.resource.data.reviewUid is string && request.resource.data.reviewUid.size() <= 128
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 2 && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    match /adProofs/{adId} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['image','ownerUid','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.image is string && request.resource.data.image.size() < 600000
        && get(/databases/$(database)/documents/ads/$(adId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/ads/$(adId)).data.status in ['pending','changes'];
      allow delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    match /ads/{adId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin()));

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title','category','city','description','links','shareProof','hasProofImage','igHandle','phone','ownerName','ownerUid','status','adminNote','likeCount','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.likeCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validAd(request.resource.data);

      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid
            && resource.data.status in ['pending','changes']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','category','city','description','links','shareProof','hasProofImage','igHandle','phone','ownerName','status','updatedAt'])
            && request.resource.data.status == 'pending'
            && request.resource.data.updatedAt == request.time
            && validAd(request.resource.data))
        || (request.auth != null
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && ((request.resource.data.likeCount == resource.data.likeCount + 1
                 && !exists(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid))
                 && existsAfter(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid)))
             || (request.resource.data.likeCount == resource.data.likeCount - 1
                 && exists(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid))
                 && !existsAfter(/databases/$(database)/documents/ads/$(adId)/likes/$(request.auth.uid)))));

      allow update: if request.auth != null
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum','ratingCount'])
        && ratingDeltaOk(adId);

      allow delete: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid && resource.data.status != 'approved');

      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rating','text','name','createdAt','updatedAt'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.updatedAt == request.time
          && ratingDeltaOk(adId);
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && ratingDeltaOk(adId));
      }

      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && getAfter(/databases/$(database)/documents/ads/$(adId)).data.likeCount == get(/databases/$(database)/documents/ads/$(adId)).data.likeCount + 1;
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/ads/$(adId)).data.likeCount == get(/databases/$(database)/documents/ads/$(adId)).data.likeCount - 1;
        allow update: if false;
      }
    }

    // Online multiplayer rooms (jo/tools/jo-room.js): no auth, 5-char codes; get-only so rooms cannot be listed.
    match /rooms/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['game','hostId','hostName','status','state','createdAt','updatedAt'])
        && request.resource.data.game in ['xo','os','ws','wm','cw']
        && request.resource.data.status == 'lobby'
        && request.resource.data.hostId is string && request.resource.data.hostId.size() <= 40
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 40
        && request.resource.data.state is string && request.resource.data.state.size() <= 4000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','state','updatedAt'])
        && request.resource.data.status in ['lobby','playing','closed']
        && request.resource.data.state is string && request.resource.data.state.size() <= 4000;
      allow delete: if false;

      match /players/{pid} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name','jt','v','vr','sc','sr','ft','pg'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow delete: if true;
      }

      match /chat/{id} {
        allow read: if true;
        allow create: if request.auth != null && !chatBlocked()
          && request.resource.data.keys().hasOnly(['p','u','n','t','ts','v','d'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.p is string && request.resource.data.p.size() <= 40
          && request.resource.data.n is string && request.resource.data.n.size() <= 40
          && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 200
          && request.resource.data.ts is number
          && (!('v' in request.resource.data) || (request.resource.data.v == true && request.resource.data.d is number && request.resource.data.d <= 21));
        allow update, delete: if false;
      }

      match /voices/{id} {
        allow read: if true;
        allow create: if request.auth != null && !chatBlocked()
          && request.resource.data.keys().hasOnly(['u','a','ts'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.a is string && request.resource.data.a.size() < 600000
          && request.resource.data.ts is number;
        allow update, delete: if false;
      }

      match /secret/{pid} {
        allow get: if true;
        allow list: if false;
        allow create, update: if request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 300;
        allow delete: if false;
      }
    }
  }
}
